generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql"; url = env("DATABASE_URL") }

model Project {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  summary     String
  body        String   @default("")
  image       String?
  stack       String[]
  liveUrl     String?
  repoUrl     String?
  year        Int
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model Post {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  excerpt   String   @default("")
  body      String
  published Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Message {
  id        String   @id @default(cuid())
  name      String
  email     String
  body      String
  createdAt DateTime @default(now())
}

model PageView {
  id        String   @id @default(cuid())
  path      String
  referrer  String?
  createdAt DateTime @default(now())
  @@index([path])
}
